# ==============================================================================
# CloudPulse - Root Environment Variables Template
# Copy this file to .env before running docker-compose:
#   cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cloudpulse
POSTGRES_PORT=5432

# Backend Service Configuration (NestJS)
BACKEND_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@db:5432/cloudpulse?schema=public
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Frontend Service Configuration (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
